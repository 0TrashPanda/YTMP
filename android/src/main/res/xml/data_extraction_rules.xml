<?xml version="1.0" encoding="utf-8"?>
<!-- The YouTube Music sign-in (and the logs and the song cache) stay on this phone: not in backups, not moved to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="youtube.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="song-cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="youtube.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="song-cache/" />
    </device-transfer>
</data-extraction-rules>
