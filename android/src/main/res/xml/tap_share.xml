<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing by holding phones together: the phone answers as an NFC Forum Type 4 tag (the NDEF
     application) with the link of what it shares (share/TapShareService.kt). -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/tap_share_description"
    android:requireDeviceUnlock="true">
    <aid-group android:category="other" android:description="@string/tap_share_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
