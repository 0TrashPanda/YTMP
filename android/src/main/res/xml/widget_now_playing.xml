<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget: 2 by 2 cells to start with, resizable both ways. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_now_playing"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="70dp"
    android:minResizeHeight="70dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="400dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_now_playing"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
