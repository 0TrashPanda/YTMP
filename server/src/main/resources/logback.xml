<!--
  Console, and log files that are cleaned up by themselves (see [logs] in ytmp.toml).
  The properties come from setUpLogs in Main.kt; without a log folder it uses logback-console.xml.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ytmp.log.dir:-logs}/ytmp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- A file per day, split at 10 MB; old days and anything over the cap are deleted. -->
            <fileNamePattern>${ytmp.log.dir:-logs}/ytmp.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>${ytmp.log.days:-14}</maxHistory>
            <totalSizeCap>${ytmp.log.maxMb:-100}MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="${ytmp.log.level:-INFO}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor.client" level="WARN"/>
</configuration>
