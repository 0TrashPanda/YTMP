{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTMP",
  "mainBinaryName": "ytmp",
  "version": "0.1.0",
  "identifier": "dev.trashpanda.ytmp.desktop",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "publisher": "TrashPanda",
    "category": "Music",
    "shortDescription": "A shared music queue for YouTube Music",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
